# Puerto en el que arranca la API
PORT=3000

# Conexión con PostgreSQL: postgresql://usuario:contraseña@servidor:puerto/base_de_datos
# Pon aquí tu usuario y contraseña de PostgreSQL en el archivo .env (nunca en .env.example).
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/repeat

# Origen permitido para las peticiones de la web (en desarrollo, la web de Expo)
CORS_ORIGIN=http://localhost:8081

# RNF-11 · Clave con la que se firman los tokens de sesión (JWT).
# En local puede ser cualquier texto; en producción es obligatoria y de al menos 32 caracteres.
JWT_SECRET=CAMBIAR-por-un-texto-largo-y-secreto-de-32-caracteres-o-mas

# Intentos permitidos por IP cada 15 minutos en registro e inicio de sesión.
AUTH_RATE_LIMIT=20
# Peticiones por IP y minuto a las fichas y al buscador (frena la descarga masiva).
READ_RATE_LIMIT=120

# HU-20 · Importación del catálogo desde MusicBrainz
# true para que la API importe sola las novedades cada día (en desarrollo, mejor false
# y lanzarla a mano con npm run import:initial o npm run import:daily).
IMPORT_ENABLED=false
# Géneros que se importan: etiqueta de MusicBrainz=nombre que se guarda, separados por comas.
# Si se deja vacío, se usan pop, rock, indie, electronic, hip hop, jazz, classical, reggaeton, metal y soul.
IMPORT_GENRES=
# Álbumes por género en la primera importación y tope diario de novedades por género.
IMPORT_INITIAL_LIMIT_PER_GENRE=500
IMPORT_DAILY_LIMIT_PER_GENRE=1000
# Hora del día (0-23) a la que se lanza la importación diaria.
IMPORT_DAILY_HOUR=3
# MusicBrainz pide que cada aplicación se identifique con un nombre y un contacto.
MUSICBRAINZ_USER_AGENT=Repeat/1.0.0 ( https://github.com/martaavlez/2026-2027-ISW-Grupo-C )
