# Puerto en el que arranca la API
PORT=3000

# Conexión con PostgreSQL: postgresql://usuario:contraseña@servidor:puerto/base_de_datos
# Pon aquí tu usuario y contraseña de PostgreSQL en el archivo .env (nunca en .env.example).
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/repeat

# Origen permitido para las peticiones de la web (en desarrollo, la web de Expo)
CORS_ORIGIN=http://localhost:8081

# RNF-11 · Clave con la que se firman los tokens de sesión (JWT).
# En local puede ser cualquier texto; en producción es obligatoria y de al menos 32 caracteres.
JWT_SECRET=CAMBIAR-por-un-texto-largo-y-secreto-de-32-caracteres-o-mas

# Intentos permitidos por IP cada 15 minutos en registro e inicio de sesión.
AUTH_RATE_LIMIT=20
