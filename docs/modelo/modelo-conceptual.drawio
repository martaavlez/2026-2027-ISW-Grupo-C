gonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#374151;fontFamily=Helvetica;fontSize=12;fontStyle=2;exitX=0.93;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="714.8" y="-10.0"/><mxPoint x="1200.0" y="-10.0"/><mxPoint x="1200.0" y="720.8"/></Array></mxGeometry></mxCell><mxCell id="e12_56" value="0..1" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e12"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e12_57" value="*" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e12"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="22" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n0" value="Un usuario es miembro de una&lt;br&gt;comunidad como mucho una vez.&lt;br&gt;Cada comunidad tiene exactamente&lt;br&gt;un administrador principal y nunca&lt;br&gt;se queda sin administrador&lt;br&gt;(RN-04, RN-24)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="197" height="106" as="geometry"/></mxCell><mxCell id="n1" value="Con dos expulsiones ya no puede&lt;br&gt;volver a solicitar el acceso (RN-17)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="340" width="195" height="46" as="geometry"/></mxCell><mxCell id="n2" value="Se refiere a una reseña o a una publicación, nunca a&lt;br&gt;las dos. Un usuario no denuncia dos veces lo mismo.&lt;br&gt;Las de reseñas las resuelve el administrador de la&lt;br&gt;plataforma; las de publicaciones, los administradores&lt;br&gt;de la comunidad (RN-18). comentario es obligatorio&lt;br&gt;si motivo = otro." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="760" width="277" height="106" as="geometry"/></mxCell><mxCell id="l0" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#374151;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c2" target="e1"><mxGeometry relative="1" as="geometry"><mxPoint x="603.2" y="129.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l1" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n0" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d5" name="6 · Enumeraciones"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="«enumeración»&lt;br&gt;&lt;b&gt;RolPlataforma&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=42;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FCE7F3;strokeColor=#9D174D;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="175" height="84" as="geometry"/></mxCell><mxCell id="c0a" value="usuario&lt;br&gt;administrador" style="text;strokeColo