 value="excluida por" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#374151;fontFamily=Helvetica;fontSize=12;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10_44" value="*" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e10"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-27" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="e10_45" value="0..1" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e10"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="22" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="n0" value="/valoraciónMedia: media de las valoraciones&lt;br&gt;de sus reseñas, sea cual sea su privacidad;&lt;br&gt;vacía si no tiene ninguna (RN-07)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="235" height="61" as="geometry"/></mxCell><mxCell id="n1" value="fechaResolución y «resuelta por» son obligatorios&lt;br&gt;si estado ≠ pendiente. Solo las crea el agente de IA&lt;br&gt;sobre lo importado ese día (RN-22)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="132" width="268" height="61" as="geometry"/></mxCell><mxCell id="n2" value="Solo se registra cuando el agente aplica&lt;br&gt;una corrección segura (RNF-07)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="30" width="215" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Lo que el administrador elimina se&lt;br&gt;guarda aquí y no se vuelve a importar&lt;br&gt;(RN-21)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="204" height="61" as="geometry"/></mxCell><mxCell id="n4" value="Registro de cada importación desde&lt;br&gt;MusicBrainz (HU-20). La diaria trae lo&lt;br&gt;publicado desde la última correcta, que&lt;br&gt;es la fecha que ve el administrador&lt;br&gt;(PA-20-03). error es obligatorio si&lt;br&gt;estado = fallida." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="212" height="106" as="geometry"/></mxCell><mxCell id="l0" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n0" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n1" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n2" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="3 · Valoraciones y favoritos"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page