="1" as="geometry"><mxPoint x="6" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="n0" value="Seguir no necesita aprobación (RN-10).&lt;br&gt;Nadie puede seguirse a sí mismo." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="792" y="192.5" width="215" height="46" as="geometry"/></mxCell><mxCell id="n1" value="Como mucho una solicitud pendiente o&lt;br&gt;aceptada por pareja de usuarios (RN-11)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="792" y="284.5" width="224" height="46" as="geometry"/></mxCell><mxCell id="n2" value="Al bloquear se eliminan el seguimiento&lt;br&gt;y la amistad entre ambos (RN-12)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="792" y="372.5" width="208" height="46" as="geometry"/></mxCell><mxCell id="n3" value="motivoSuspensión es obligatorio si&lt;br&gt;estado = suspendida (RN-02).&lt;br&gt;/númeroSeguidores: número de&lt;br&gt;seguimientos en los que es el seguido." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="30" width="208" height="76" as="geometry"/></mxCell><mxCell id="n4" value="/nivelPrivacidad se hereda del&lt;br&gt;elemento al que se refiere (RN-08)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="654" y="590" width="192" height="46" as="geometry"/></mxCell><mxCell id="n5" value="Se envía por correo a la dirección&lt;br&gt;con la que se registr