/></mxGeometry></mxCell><mxCell id="e2_17" value="*" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e2"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-27" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="ocupa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#374151;fontFamily=Helvetica;fontSize=12;fontStyle=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_19" value="*" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e3"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e3_20" value="1" style="edgeLabel;resizable=0;html=1;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=12;" connectable="0" vertex="1" parent="e3"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="6" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="n0" value="Un usuario marca cada elemento como mucho&lt;br&gt;una vez. En el perfil se agrupan por tipo." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="366.0" y="4.0" width="247" height="46" as="geometry"/></mxCell><mxCell id="n1" value="Una reseña por usuario y elemento (RN-05):&lt;br&gt;si vuelve a valorar, sustituye la anterior.&lt;br&gt;Sin texto es una valoración rápida. Si no elige&lt;br&gt;privacidad, se usa su nivel por defecto (RN-09)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-169.25" y="454.0" width="252" height="76" as="geometry"/></mxCell><mxCell id="n2" value="Se calcula cada día con las valoraciones de los&lt;br&gt;últimos 7 días: las 10 mejores medias con al menos&lt;br&gt;3 valoraciones; si empatan, va primero la que&lt;br&gt;tiene más valoraciones (RN-19)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FDF2F8;strokeColor=#DB2777;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="758.0" y="570" width="269" height="76" as="geometry"/></mxCell><mxCell id="l0" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#374151;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="c3" target="e1"><mxGeometry relative="1" as="geometry"><mxPoint x="279.5" y="114.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l1" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#374151;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="c4" target="e2"><mxGeometry relative="1" as="geometry"><mxPoint x="263.8" y="374.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l2" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n0" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4" style="endArrow=none;dashed=1;html=1;strokeColor=#DB2777;" edge="1" parent="1" source="n2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="4 · Tableros y rankings personales"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="Usuario" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalSta